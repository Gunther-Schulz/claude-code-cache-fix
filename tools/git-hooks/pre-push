#!/bin/sh
# pre-push: refuse to publish a red tree (the red-main incident,
# 2026-08-02 — two pushes landed with the absence-scan guard failing
# because only targeted suites were run; the red survived a day).
#
# Activation is per-machine, ONE symlink:
#     ln -sf ../../tools/git-hooks/pre-push .git/hooks/pre-push
# NEVER via repo-local `git config core.hooksPath`: on the operator's
# machine a GLOBAL hooksPath runs the fixture-leak-scan dispatcher
# (dotfiles git/hooks/pre-push), which after its own scan chains the
# repo's .git/hooks/pre-push — a repo-local hooksPath would REPLACE the
# dispatcher and silently disable the leak scan (happened 2026-08-05;
# the dotfiles doctor now fails on a set repo-local hooksPath). A fresh
# worktree needs its node_modules symlink — see
# docs/runbooks/upstream-pr-round.md — and a missing one fails the
# suite loudly here rather than silently skipping it.
#
# Deliberate-WIP bypass: `git push --no-verify`, stated in the same
# turn/message as the push — an unstated bypass is the incident again.
#
# The suite is ~17 s (measured 2026-08-05, 2054 tests); there is no
# timeout because the known "hang" was a missing-dependency artifact,
# not the suite (BACKLOG.md stale-premise note).
#
# AIMED AT THE PUSHED COMMITS, NOT THE WORKING TREE (2026-08-08). This
# hook used to run `npm test` in the working tree, which is a different
# object from what is being published, and it failed in both directions:
#   FALSE RED  — a co-writer's UNTRACKED scratch blocked a push whose
#                commits were all green (measured: two `??` files, three
#                unrelated commits, push refused). Its cost is not the
#                delay, it is that the refusal text names --no-verify,
#                and this hook is CHAINED behind the dotfiles leak scan,
#                so a bypass taken for someone else's red also skips the
#                scan at the boundary where history stops being editable.
#   FALSE GREEN — the same defect reversed and silent: edit a file, do
#                not commit it, push. The suite verifies the edit while
#                the pushed commit is broken, and the hook records a
#                green. That is the direction that lets a broken commit
#                reach main, and it is why this was worth changing.
# So the suite now runs in a DETACHED WORKTREE at each pushed sha.
# Deliberately NOT `git stash`: a pre-push hook must never mutate a
# working copy a co-writer may be mid-edit in. The worktree needs its
# node_modules symlink, same standing hazard as any other worktree here.
# Red-first proof for both directions: test/pre-push-hook.test.mjs.

set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
REPO="$(pwd)"

# What is actually being published. Git feeds pre-push one line per ref
# on stdin: "<local ref> <local sha> <remote ref> <remote sha>". A branch
# DELETION carries an all-zero local sha and ships no code, so it is
# skipped rather than tested. If stdin is empty or unreadable we fall
# back to HEAD — still the committed state, never the working tree.
PUSH_SHAS=""
while read -r _lref lsha _rref _rsha; do
  case "$lsha" in
    "" | *[!0-9a-f]*) continue ;;
    *[!0]*) PUSH_SHAS="$PUSH_SHAS $lsha" ;;
  esac
done
if [ -z "$PUSH_SHAS" ]; then
  PUSH_SHAS="$(git rev-parse HEAD 2>/dev/null || true)"
  [ -n "$PUSH_SHAS" ] || {
    echo "pre-push: REFUSED — cannot determine what is being pushed." >&2
    exit 1
  }
fi

WTROOT=""
cleanup() {
  [ -n "$WTROOT" ] || return 0
  git worktree remove --force "$WTROOT/t" >/dev/null 2>&1
  rm -rf "$WTROOT"
  git worktree prune >/dev/null 2>&1
}
trap cleanup EXIT INT TERM HUP

# Git exports its hook environment (GIT_DIR and friends) into this
# process, and npm test spawns tests that build SCRATCH git repos via
# cwd-based discovery. An inherited ABSOLUTE GIT_DIR overrides that
# discovery and redirects every scratch-repo git call into the REAL
# repo — measured 2026-08-05: a worktree push's suite run wrote
# core.bare=true plus the t/t@t fixture identity into the shared
# .git/config and mis-authored a real pushed commit. Main-tree pushes
# were immune only because their GIT_DIR is the RELATIVE ".git", which
# re-resolves inside each test's temp cwd. Unset the whole family
# (after the cd above, which legitimately needs the hook context).
unset $(git rev-parse --local-env-vars) 2>/dev/null || true

for sha in $PUSH_SHAS; do
  short="$(git rev-parse --short "$sha" 2>/dev/null || echo "$sha")"

  # Cheapest check first, and it is the one whose failure is IRREVERSIBLE.
  # GitHub rejects any blob at or over 100 MiB, so a tree carrying one
  # cannot be pushed — but the commit already exists locally when the push
  # fails, and this fork's main is published deployment state that must
  # never be rewritten (FORK-NOTES.md). Found 2026-08-17: `harvest --pin`
  # writes a pin containing the pair's whole conversation prefix, so a deep
  # conversation yields a 188 MB fixture with nothing on any route saying
  # so. Runs against the PUSHED TREE, same object the suite below uses.
  if [ -f "$REPO/tools/oversize-blob-guard.mjs" ]; then
    if ! (cd "$REPO" && node tools/oversize-blob-guard.mjs "$sha"); then
      echo "pre-push: REFUSED — $short carries a blob the remote will not accept (see above)." >&2
      exit 1
    fi
  fi

  echo "pre-push: npm test (full suite) at pushed commit $short ..." >&2

  WTROOT="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-wt.XXXXXX")" || exit 1
  if ! git worktree add --detach --quiet "$WTROOT/t" "$sha" 2>/tmp/pre-push-wt.$$.log; then
    echo "pre-push: REFUSED — could not check out $short to verify it:" >&2
    cat /tmp/pre-push-wt.$$.log >&2
    rm -f /tmp/pre-push-wt.$$.log
    exit 1
  fi
  rm -f /tmp/pre-push-wt.$$.log
  # Standing worktree hazard: without this every proxy suite dies
  # ERR_MODULE_NOT_FOUND and two tests appear to hang ~900 s.
  [ -d "$REPO/node_modules" ] && ln -s "$REPO/node_modules" "$WTROOT/t/node_modules"

  # A durable path in this fork's XDG state dir, not /tmp — an intermittent
  # red is the run least likely to be watched, so its evidence must outlive
  # the shell PID that produced it (BACKLOG.md, "the suite has at least one
  # INTERMITTENT test"). Shares naming/retention with the npm-test wrapper
  # via tools/suite-run-log.mjs; falls back to a $$ -scoped /tmp path only if
  # that helper itself cannot run (e.g. this hook file copied standalone into
  # a fixture repo without the rest of the tree — see test/pre-push-hook.
  # test.mjs), so a broken helper never blocks the push decision on an
  # unrelated failure.
  SUITE_LOG="$(cd "$REPO" && node tools/suite-run-log.mjs next-path pre-push "$$" 2>/dev/null)"
  [ -n "$SUITE_LOG" ] || SUITE_LOG="/tmp/pre-push-suite.$$.log"

  if ! (cd "$WTROOT/t" && npm test) >"$SUITE_LOG" 2>&1; then
    echo "pre-push: REFUSED — full suite is red AT THE PUSHED COMMIT $short." >&2
    echo "pre-push: (your working tree is not what was tested; this is the" >&2
    echo "pre-push:  commit you are publishing). Tail of the run:" >&2
    tail -25 "$SUITE_LOG" >&2
    echo "pre-push: full log (kept — this is the last-failure record): $SUITE_LOG" >&2
    echo "pre-push: deliberate WIP push: git push --no-verify (state it)." >&2
    (cd "$REPO" && node tools/suite-run-log.mjs prune pre-push >/dev/null 2>&1) || true
    exit 1
  fi
  rm -f "$SUITE_LOG"
  (cd "$REPO" && node tools/suite-run-log.mjs prune pre-push >/dev/null 2>&1) || true
  cleanup
  WTROOT=""
done

echo "pre-push: suite green at the pushed commit(s), push allowed." >&2
exit 0
