node_modules/
.DS_Store
*.log
__pycache__/

# .claude/ holds a mix of repo-routing identity and per-developer local state.
# Track only the routing files; ignore everything else.
.claude/*
!.claude/agent-name
!.claude/github-app
# lanes.json is a routing file by the same rule as the two above, and it has
# to be TRACKED for a second reason the others do not have: the commit-time
# lane gate reads the declaration out of the INDEX (`git show :<path>`), so a
# declaration that is merely present on disk arms nothing at all — it reads
# exactly like a repo that never declared lanes.
!.claude/lanes.json
.possibilities/
package-lock.json

# tools/dossier.mjs writes its bust dossiers into the repo root. They hold live
# session ids, transcript paths and capture filenames — the exact classes the
# hygiene rules keep out of this public tree — and the tool's own header says
# "not committed". Nothing enforced that until this line: the push-side absence
# scan is a backstop at the boundary, not a guard in the working tree.
dossier-*.md
